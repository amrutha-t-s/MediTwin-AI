generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  passwordHash        String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  fullName            String?
  role                String               @default("patient")
  resetToken          String?
  resetTokenExpire    DateTime?
  auditLogs           AuditLog[]
  consents            Consent[]
  dailyHealthLogs     DailyHealthLog[]
  familyHistories     FamilyHistory[]
  healthProfile       HealthProfile?
  medications         Medication[]
  predictions         Prediction[]
  scenarioSimulations ScenarioSimulation[]
}

model HealthProfile {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @db.Uuid
  age                  Int?
  sex                  String?
  heightCm             Float?
  weightKg             Float?
  bloodGroup           String?
  conditions           String?
  allergies            String?
  familyHistory        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  alcohol              String?
  bloodPressureHistory String?
  cholesterol          String?
  dateOfBirth          DateTime?
  diabetesStatus       String?
  diabetesType         String?
  diagnosisYear        Int?
  fastingGlucose       Float?
  foodPreference       String?
  gender               String?
  hba1c                Float?
  heartHistory         String?
  kidneyHistory        String?
  location             String?
  otherConditions      String?
  smoking              String?
  typicalActivity      String?
  typicalSleep         Float?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyHealthLog {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  date               DateTime

  glucose            Float?

  bpSystolic         Int?
  bpDiastolic        Int?
  heartRate          Int?

  weightKg           Float?
  waistCircumference Float?

  sleepHours         Float?
  steps              Int?
  waterLiters        Float?

  // Day 18 - Activity & Sleep
  exerciseMinutes    Int?
  exerciseType       String?
  sittingHours       Float?
  sleepStartTime     String?
  wakeUpTime         String?
  sleepDuration      Float?
  sleepQuality       Int?
  nightAwakenings    Int?

  foodSummary        String?
  // Day 19 - Food Entry
  foodDetails        Json?
  hasSugaryDrink     Boolean?
  hasFriedFood       Boolean?
  isHighCarb         Boolean?
  hasVegetables      Boolean?
  mealSatisfaction   Int?

  // Medication Adherence
  medicationName     String?
  medicationDosage   String?
  medicationFrequency String?
  medicationTaken    String?
  missedReason       String?

  // Lifestyle & Wellbeing
  alcohol            String?
  smoking            String?
  stressLevel        Int?
  energyLevel        Int?
  symptoms           String?

  exercise           String?
  mood               String?
  notes              String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model Medication {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  name         String
  dosage       String?
  frequency    String?
  startDate    DateTime?
  endDate      DateTime?
  instructions String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FamilyHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  relation  String
  condition String
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Prediction {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  predictionType String
  result         String
  confidence     Float?
  explanation    String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ScenarioSimulation {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String
  description String?
  changes     Json
  result      Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Consent {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  consentType String
  granted     Boolean
  version     String
  grantedAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String?
  entityId  String?
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
