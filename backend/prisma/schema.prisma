generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  profile   Profile?
  entries   DailyEntry[]
  scenarios Scenario[]
}

model Profile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id])
  age           Int?
  sex           String?
  heightCm      Float?
  weightKg      Float?
  conditions    String?
  medications   String?
  familyHistory String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DailyEntry {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  date         DateTime
  glucose      Float?
  bpSystolic   Int?
  bpDiastolic  Int?
  foodSummary  String?
  sleepHours   Float?
  steps        Int?
  medsTaken    Boolean?
  alcoholUnits Float?
  notes        String?
  createdAt    DateTime @default(now())
}

model Scenario {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  name        String
  description String?
  changes     String   // JSON string
  createdAt   DateTime @default(now())
}