generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  fullName     String?
  email        String  @unique
  passwordHash String
  role         String  @default("patient")

  resetToken       String?
  resetTokenExpire DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  healthProfile HealthProfile?

  dailyHealthLogs     DailyHealthLog[]
  medications         Medication[]
  familyHistories     FamilyHistory[]
  predictions         Prediction[]
  scenarioSimulations ScenarioSimulation[]
  consents            Consent[]
  auditLogs           AuditLog[]
}

model HealthProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  // ========================================
  // STEP 1: BASIC DETAILS
  // ========================================

  dateOfBirth DateTime?
  gender      String?
  heightCm    Float?
  weightKg    Float?
  location    String?

  // ========================================
  // STEP 2: DIABETES INFORMATION
  // ========================================

  diabetesStatus String?
  diabetesType   String?
  diagnosisYear  Int?
  hba1c          Float?
  fastingGlucose Float?

  // ========================================
  // STEP 3: MEDICAL HISTORY
  // ========================================

  bloodPressureHistory String?
  cholesterol          String?
  kidneyHistory        String?
  heartHistory         String?
  otherConditions      String?

  // ========================================
  // STEP 4: LIFESTYLE
  // ========================================

  smoking         String?
  alcohol         String?
  typicalSleep    Float?
  typicalActivity String?
  foodPreference  String?

  // ========================================
  // EXISTING HEALTH PROFILE FIELDS
  // ========================================

  age           Int?
  sex           String?
  bloodGroup    String?
  conditions    String?
  allergies     String?
  familyHistory String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyHealthLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  date        DateTime
  glucose     Float?
  bpSystolic  Int?
  bpDiastolic Int?
  heartRate   Int?
  sleepHours  Float?
  steps       Int?
  waterLiters Float?
  foodSummary String?
  exercise    String?
  mood        String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model Medication {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  name         String
  dosage       String?
  frequency    String?
  startDate    DateTime?
  endDate      DateTime?
  instructions String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FamilyHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  relation  String
  condition String
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Prediction {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  predictionType String
  result         String
  confidence     Float?
  explanation    String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ScenarioSimulation {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String
  description String?
  changes     Json
  result      Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Consent {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  consentType String
  granted     Boolean
  version      String
  grantedAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String?
  entityId  String?
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}